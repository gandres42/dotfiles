[Unit]
Description=Claude Code OpenAI Server (CCI)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Utilities/claude-code-openai-server
EnvironmentFile=%h/Utilities/claude-code-openai-server/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Utilities/claude-code-openai-server/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
